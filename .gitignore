# =====================================
# 1. 敏感信息与环境变量
# =====================================
.env
.env.*
!.env.example
*.pem
*.key

# =====================================
# 2. 数据文件
# =====================================
# 忽略 data 下的所有文件
data/**
# 保留文件夹本身，以及内部的 .gitkeep
!data/
!data/raw/
!data/processed/
!data/**/.gitkeep
*.parquet
*.csv
*.xlsx
*.db
*.duckdb
*.sqlite
*.h5
*.pkl
*.feather

# =====================================
# 3. Python 运行缓存与构建产物
# =====================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# =====================================
# 4. 虚拟环境
# =====================================
.venv/
venv/
env/

# =====================================
# 5. 日志文件
# =====================================
*.log
logs/

# =====================================
# 6. 测试与类型检查缓存
# =====================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =====================================
# 7. 操作系统与编辑器文件
# =====================================
.DS_Store
Thumbs.db
.idea/
.vscode/
