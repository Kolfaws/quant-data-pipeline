# =====================================
# 数据源 API 配置
# =====================================
# 只在本机 .env 中填写；.env 已被 gitignore
TUSHARE_TOKEN= YOUR_TUSHARE_TOKEN

# =====================================
# 数据库配置 (DuckDB)
# =====================================
# 单库多组件：warehouse 与 factor 共用同一个 DuckDB 文件
# 必须填写本机绝对路径
DUCKDB_PATH= YOUR_LOCAL_PATH_TO_DUCKDB_FILE

# =====================================
# 其他配置
# =====================================
LOG_LEVEL=INFO
