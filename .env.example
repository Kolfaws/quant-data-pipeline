# =====================================
# 数据源 API 配置
# =====================================
# Tushare Token
TUSHARE_TOKEN=your_tushare_token_here

# =====================================
# 数据库配置 (DuckDB)
# =====================================
# 单库多组件：warehouse 与 factor 共用同一个 DuckDB 文件
DUCKDB_PATH=data/market.duckdb
# FACTOR_DB_PATH 已废弃：factor 与 warehouse 必须同库。

# =====================================
# 其他配置
# =====================================
LOG_LEVEL=INFO
